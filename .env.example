# MatchUp backend configuration.
#
#   cp .env.example .env      (or: make env)
#
# Every value here is read at startup by internal/config. A missing required
# secret is a boot failure, not a runtime surprise on the first request that
# needs it, and every problem is reported in one pass so a misconfigured
# deployment can be fixed in one edit.
#
# Which binary needs what:
#   api     HTTP + DB + Auth
#   admin   HTTP + DB + Admin
#   worker  DB + Payment + Notify
# A group is only validated in the binaries that use it, so the worker does not
# refuse to start over a missing JWT secret it will never sign with.
#
# The defaults below are the ones the code applies when the variable is unset;
# lines that are commented out document the default rather than change it.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# local | staging | production. Some safety checks relax only in local.
APP_ENV=local

# ---------------------------------------------------------------------------
# HTTP (api, admin)
# ---------------------------------------------------------------------------
PORT=8080
# The admin API is a separate process on its own port. Set this explicitly on a
# platform that injects one PORT per service, or both APIs will try to bind the
# same number.
ADMIN_PORT=8081
#HTTP_READ_TIMEOUT=15s
#HTTP_WRITE_TIMEOUT=30s
# How long a drain is allowed to take before in-flight requests are cut off.
#HTTP_SHUTDOWN_TIMEOUT=20s

# ---------------------------------------------------------------------------
# Database (all three)
# ---------------------------------------------------------------------------
# docker compose overrides this with the service name; this value is for
# running the binaries on the host against the compose Postgres.
DATABASE_URL=postgres://matchup:localdev@localhost:55432/matchup?sslmode=disable
#DB_MAX_CONNS=10
#DB_MIN_CONNS=2
#DB_MAX_CONN_LIFETIME=1h
#DB_MAX_CONN_IDLE_TIME=30m

# ---------------------------------------------------------------------------
# Auth (api)
# ---------------------------------------------------------------------------
# At least 32 characters each, and the access and refresh keys must differ. A
# short key makes offline brute force of the HMAC practical.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789abcd
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-0123456789abcd

# Required by the api binary even locally, because sign-in with Google is not
# an optional route. Google-issued tokens are rejected until this is the real
# client ID; email and password sign-in works regardless.
GOOGLE_OAUTH_CLIENT_ID=replace-with-oauth-client-id.apps.googleusercontent.com

#ACCESS_TOKEN_TTL=15m
#REFRESH_TOKEN_TTL=720h
#PASSWORD_RESET_TTL=1h

# ---------------------------------------------------------------------------
# Admin API (admin)
# ---------------------------------------------------------------------------
# A separate trust domain: these must differ from each other and the access key
# must differ from the public API's. Sharing one would let a player's token be
# replayed against admin endpoints if a role check were ever missed.
ADMIN_JWT_ACCESS_SECRET=local-dev-admin-access-secret-change-me-0123456789
ADMIN_JWT_REFRESH_SECRET=local-dev-admin-refresh-secret-change-me-0123456789

# Exact dashboard origins, comma separated. Never a wildcard: the admin API is
# the only browser-facing surface here and its responses are credentialed.
# Required outside local.
ADMIN_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Rate limiting (api, admin)
# ---------------------------------------------------------------------------
# The global per-IP limit. Auth, booking and payment endpoints have their own
# tighter limits in code, because what they cost is a property of the endpoint
# rather than something an operator should have to tune.
#RATE_LIMIT_RPS=10
#RATE_LIMIT_BURST=20

# ---------------------------------------------------------------------------
# Booking policy (api, admin, worker -- validated in all three)
# ---------------------------------------------------------------------------
# PRD FR12. At least 1 minute, and longer than EXPIRY_WARNING_WINDOW.
#BOOKING_HOLD_DURATION=5m
# Weeks in a monthly plan. The booking service prices against it and the admin
# service refuses to create a recurring slot too short to sell one.
#MONTHLY_WEEK_COUNT=4

# ---------------------------------------------------------------------------
# Payment verification (worker)
# ---------------------------------------------------------------------------
# The business's own receiving accounts. Every receipt is checked against these
# before a booking is confirmed: a real transaction that paid somebody else is
# not payment. Required by the worker.
MERCHANT_CBE_ACCOUNT=1000000000000
MERCHANT_TELEBIRR_ACCOUNT=0900000000

#CBE_VERIFY_TIMEOUT=20s
#TELEBIRR_VERIFY_TIMEOUT=20s
# Attempts per queued verification before it fails permanently and the booking
# parks for human review. Stamped onto each job when it is queued, so changing
# it cannot strand or resurrect work already in flight.
#VERIFY_MAX_ATTEMPTS=5

# Disables TLS verification against CBE's endpoints. It exists because CBE's
# legacy host has served an invalid chain in the past. With it on, a receipt is
# forgeable by anyone on the network path, so config refuses to accept it
# unless APP_ENV=local.
#ALLOW_INSECURE_VERIFIER_TLS=false

# Optional Telebirr routing, read by the verifier library itself. Leave unset to
# use the official receipt URL only.
#FALLBACK_PROXIES=https://proxy-one.example,https://proxy-two.example
#TELEBIRR_PROXY_LABELS=primary,backup
#TELEBIRR_PROXY_KEY=
#SKIP_PRIMARY_VERIFICATION=false

# ---------------------------------------------------------------------------
# Notification delivery (worker)
# ---------------------------------------------------------------------------
# Required outside local. Left empty, email delivery is disabled and its
# deliveries stay pending rather than failing, so adding a key later drains the
# backlog instead of finding it discarded. There is no SMTP path in the system,
# so a local mail catcher is of no use here.
RESEND_API_KEY=
#RESEND_FROM_ADDRESS=MatchUp <no-reply@matchup.et>

# Email copy.
#APP_NAME=MatchUp
SUPPORT_EMAIL=support@matchup.et
# Base links a single-use token is appended to, normally app deep links. Left
# empty the mail carries the code alone rather than a link that goes nowhere.
# PASSWORD_RESET_URL is required outside local.
PASSWORD_RESET_URL=https://app.matchup.et/reset-password
EMAIL_VERIFY_URL=https://app.matchup.et/verify-email

# ---------------------------------------------------------------------------
# Observability (all three)
# ---------------------------------------------------------------------------
#LOG_LEVEL=info
# json or text. Unset resolves to text locally and json everywhere else,
# because a person reads one and a log aggregator reads the other.
#LOG_FORMAT=

# ---------------------------------------------------------------------------
# Worker cadence (worker)
# ---------------------------------------------------------------------------
#VERIFY_POLL_INTERVAL=2s
# PRD FR13 pairs this with the hold duration: the sweep is what makes the
# 5-minute hold real.
#EXPIRY_SWEEP_INTERVAL=15s
#NOTIFY_POLL_INTERVAL=5s
# How often abandoned claims are handed back to another worker.
#RECONCILE_INTERVAL=5m
#VERIFY_BATCH_SIZE=10
#NOTIFY_BATCH_SIZE=25
# How long a claim may sit before the process holding it is assumed dead. Every
# job's timeout is derived from this.
#STUCK_JOB_THRESHOLD=5m
# How far ahead of expiry the "finish your payment" nudge goes out. Must be
# shorter than BOOKING_HOLD_DURATION, or the warning arrives after the spots
# are already gone.
#EXPIRY_WARNING_WINDOW=2m
