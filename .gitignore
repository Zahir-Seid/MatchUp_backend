# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled entrypoints. `make build` writes them to bin/; a bare `go build
# ./cmd/api` drops one in the repository root.
/bin/
/api
/admin
/worker

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Local credentials: Firebase service accounts and OAuth client secrets.
*firebase-adminsdk*.json
client_secret_*.json

# Editor/IDE
# .idea/
# .vscode/

# Local product and architecture documents
/docs/

# Staging directory for `make docs`. The generated and committed OpenAPI
# specifications live in internal/openapi/.
/.openapi/
